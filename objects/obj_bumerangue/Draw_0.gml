gpu_set_blendmode(bm_add);
draw_set_alpha(0.3);
draw_set_color(make_color_rgb(255, 210, 120));
draw_circle(x, y, 18, false);
draw_set_alpha(0.55);
draw_circle(x, y, 8, false);
gpu_set_blendmode(bm_normal);
draw_set_alpha(1);
var _c = dcos(ang);
var _s = -dsin(ang);
var _tx = x + _c * 20;
var _ty = y + _s * 20;
var _hx = x - _c * 8;
var _hy = y - _s * 8;
var _nx = -_s * 3;
var _ny = _c * 3;
draw_set_color(make_color_rgb(225, 230, 240));
draw_triangle(x + _nx, y + _ny, x - _nx, y - _ny, _tx, _ty, false);
draw_set_color(make_color_rgb(150, 160, 175));
draw_line(x, y, _tx, _ty);
draw_set_color(make_color_rgb(205, 165, 60));
draw_line_width(x - _nx * 1.7, y - _ny * 1.7, x + _nx * 1.7, y + _ny * 1.7, 2);
draw_line_width(x, y, _hx, _hy, 2.5);
draw_set_alpha(0.25);
draw_set_color(make_color_rgb(255, 230, 160));
draw_circle(x, y, 20, true);
draw_set_alpha(1);
draw_set_color(c_white);
